# Copy to .env.production only after provisioning your own database and TLS proxy.
NODE_ENV=production
PORT=3000
CLIENT_ORIGIN=https://bagiya.example.com
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
MONGO_URI=mongodb://USERNAME:PASSWORD@DB_HOST:27017/bagiya?replicaSet=rs0&authSource=admin
# nginx is the single trusted proxy to the API; do not expose the API directly.
TRUST_PROXY=1

# Candidate one-time milestones remain deferred. Daily login (10 coins) is always enabled.
ENABLE_MILESTONE_CHALLENGES=false

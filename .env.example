# Local development only. Production requires a unique random secret and HTTPS.
NODE_ENV=development
PORT=3000
WEB_PORT=5173
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=local-development-only-change-before-deploying
MONGO_URI=mongodb://localhost:27017/bagiya?replicaSet=rs0&directConnection=true
# Set 1 only behind one trusted reverse proxy.
TRUST_PROXY=0
API_PROXY_TARGET=http://localhost:3000

# Candidate one-time milestones remain deferred. Daily login (10 coins) is always enabled.
ENABLE_MILESTONE_CHALLENGES=false
